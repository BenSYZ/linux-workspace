#!/usr/bin/sh

/usr/bin/busybox --install -s /usr/bin

mkdir -p /proc /dev /sys /tmp
ln -s usr/bin /bin

mount -t proc     proc  /proc
mount -t tmpfs    dev   /dev
mount -t sysfs    sys   /sys
mount -t tmpfs    tmpfs /tmp

#[ -e /dev/console ] || mknod /dev/console c 5 1
#[ -e /dev/null ] || mknod /dev/null c 1 3

if [ -e sbin/udevd ];then
## debian initrd: scripts/init-premount/udev
    echo > /proc/sys/kernel/hotplug

    mkdir -p /dev/.udev/db/
    udevd --daemon

    mkdir -p /dev/.udev/queue/
    udevtrigger
    udevsettle || true
## debian initrd: scripts/init-premount/udev
else
    t_mknod(){
        [ -e "$1" ] || mknod "$@"
    }
    t_mknod /dev/sda     b 8 0
    t_mknod /dev/sda1    b 8 1
    t_mknod /dev/sda2    b 8 2

    t_mknod /dev/hda     b 3 0
    t_mknod /dev/hda1    b 3 1
    t_mknod /dev/hda2    b 3 2

    t_mknod /dev/tty1    c 4 0
    t_mknod /dev/tty2    c 4 1
    t_mknod /dev/ttyS0   c 4 64

    t_mknod /dev/console c 5 1

    t_mknod /dev/null    c 1 3
fi

echo "ctrl+c to run sh"
if ! setsid cttyhack timeout 3 sleep 1;then
    setsid cttyhack busybox sh
    if [ -e exec ];then
        exec /usr/bin/sh
    fi
fi

mkdir -p new_root
mount /dev/sda1 new_root

mount --move /proc /new_root/proc
mount --move /sys  /new_root/sys
mount --move /dev  /new_root/dev
mount --move /tmp  /new_root/tmp

# 1. mountpoint: not released
# 2. file in ramfs: umount by ourself
exec_pivot_root(){
    # umount by ourself later
    mkdir -p new_root/old_root
    pivot_root new_root new_root/old_root

    # S1: free fd in old_root
    exec 1>/dev/console
    exec 2>/dev/console
    exec 0</dev/console

    # S2: free init in old_root
    #exec /usr/bin/sh
    #exec /usr/bin/init
    exec "$@"
}

# the recommand way in Linux kernel
exec_pivot_root2(){
    # shellcheck disable=2164
    cd new_root
    pivot_root . .

    # S1: free fd in old_root
    exec 1>/dev/console
    exec 2>/dev/console
    exec 0</dev/console

    umount -l /
    # S2: free init in old_root
    #exec /usr/bin/sh
    #exec /usr/bin/init
    exec "$@"
}
# 1. mountpoint: not released
# 2. file in ramfs: deleted
exec_switch_root(){
    exec 1>/new_root/dev/console
    exec 2>/new_root/dev/console
    exec 0</new_root/dev/console

    exec switch_root /new_root "$@"
    #exec run-init /new_root "$@"
}

# 1. mountpoint: not released
# 2. file in ramfs: delete manually
exec_chroot(){
    exec 1>/new_root/dev/console
    exec 2>/new_root/dev/console
    exec 0</new_root/dev/console

    find / -xdev ! -type d -exec rm {} +
    find / -xdev -type d -exec rmdir -p {} + 2>/new_root/dev/null
    find / -xdev

    #exec switch_root new_root /bin/sh
    exec chroot /new_root "$@"
}

init=/sbin/init
# does not support in 2.6.24, ramfs cannot be pivot_root
#exec_pivot_root "$init"
#exec_switch_root "$init"
exec_chroot "$init"
